<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <EditText
        android:id="@+id/editTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Заголовок"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Содержание"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:maxLines="10"
        android:scrollbars="vertical"
        android:gravity="top|start"
        android:layout_marginBottom="16dp" />

    <!-- Кнопка для выбора даты и времени -->
    <Button
        android:id="@+id/btnDateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Выбрать дату и время"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Отображение выбранной даты и времени -->
    <TextView
        android:id="@+id/textDateTimeDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Дата и время не выбраны"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/okButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            android:layout_marginEnd="16dp"
            android:enabled="false"
            android:onClick="onOK" />

        <Button
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:onClick="onCancel" />

    </LinearLayout>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Назад"
        android:layout_gravity="center_horizontal"
        android:onClick="goBack" />

</LinearLayout>
